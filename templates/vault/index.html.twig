{% extends 'base.html.twig' %}

{% block title %}VaultGuard - Mon Coffre-Fort{% endblock %}

{% block body %}
<div class="container py-5">
    <!-- En-tête de la page -->
    <div class="row mb-4 align-items-center">
        <div class="col">
            <h1 class="h3 fw-bold text-dark">
                <i class="bi bi-shield-lock-fill text-primary"></i> Mon Coffre-Fort VaultGuard
            </h1>
            <p class="text-muted">Gère tes identifiants et mots de passe en toute sécurité.</p>
        </div>
        <div class="col-auto">
            <span class="badge bg-success px-3 py-2 fs-6">
                <i class="bi bi-lock-fill"></i> Session Sécurisée
            </span>
        </div>
    </div>

    <!-- Messages flash -->
    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}

    <div class="row g-4">
        <!-- Formulaire d'ajout (Carte à gauche) -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-header bg-dark text-white p-4">
                    <h5 class="mb-0 fw-semibold">
                        <i class="bi bi-plus-circle me-2"></i> Ajouter un identifiant
                    </h5>
                </div>
                <div class="card-body p-4 bg-light">
                    {{ form_start(form, {'attr': {'class': 'needs-validation'}}) }}
                        <div class="mb-3">
                            {{ form_row(form.title, {'attr': {'class': 'form-control rounded-3', 'placeholder': 'ex: Email Pro, GitHub...'}}) }}
                        </div>
                        <div class="mb-3">
                            {{ form_row(form.login, {'attr': {'class': 'form-control rounded-3', 'placeholder': 'Nom d’utilisateur ou email'}}) }}
                        </div>
                        <div class="mb-3">
                            {{ form_row(form.encryptedPassword, {'attr': {'class': 'form-control rounded-3', 'placeholder': 'Mot de passe sécurisé'}}) }}
                        </div>
                        <button type="button" class="btn btn-outline-secondary btn-sm mb-3 w-100 rounded-3">
                            <i class="bi bi-key"></i> Générer un mot de passe fort
                        </button>
                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary rounded-3 py-2 fw-semibold shadow-sm">
                                Enregistrer dans le coffre
                            </button>
                        </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>

        <!-- Liste des éléments enregistrés (À droite) -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-header bg-white p-4 border-bottom">
                    <h5 class="mb-0 fw-semibold text-dark">
                        <i class="bi bi-list-nested me-2 text-primary"></i> Tes Identifiants Enregistrés
                    </h5>
                </div>
                <div class="card-body p-4">
                    {% if credentials is defined and credentials is not empty %}
                        <div class="list-group list-group-flush">
                            {% for credential in credentials %}
                                <div class="list-group-item px-0 py-3 d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="mb-1 fw-bold text-dark">{{ credential.title }}</h6>
                                        <small class="text-muted"><i class="bi bi-person"></i> {{ credential.login }}</small>
                                    </div>
                                    <div class="btn-group">
                                        <button class="btn btn-sm btn-outline-light text-dark border shadow-sm rounded-start-3" title="Afficher">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-light text-danger border shadow-sm rounded-end-3" title="Supprimer">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-folder2-open display-4 mb-3 d-block text-secondary"></i>
                            <p class="mb-0">Ton coffre-fort est vide pour l'instant.</p>
                            <small>Ajoute ton premier identifiant via le formulaire.</small>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}